{
    "name": "boldgrid/post-and-page-builder",
    "description": "Post and Page Builder is a standalone plugin which adds functionality to the existing TinyMCE Editor.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "boldgrid/library": "^2.13.13"
    },
    "config": {
        "platform": {
            "php": "7.4.0"
        },
        "platform-check": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "composer run-script post-autoload-dump -d ./vendor/boldgrid/library"
        ],
        "test": "phpunit --no-coverage",
        "test:ajax": "phpunit --no-coverage --group ajax",
        "lint:php": "bash bin/php-lint.sh",
        "phpcs:changed": "@php bin/phpcs-changed.php",
        "phpcs:i18n": "phpcs --standard=phpcs.ruleset.xml --sniffs=WordPress.WP.I18n -s",
        "phpstan": [
            "@composer install --no-interaction --working-dir=tests/phpstan",
            "tests/phpstan/vendor/bin/phpstan analyse -c tests/phpstan/phpstan.neon.dist --memory-limit=1G"
        ],
        "phpcompat": [
            "@composer install --no-interaction --working-dir=tests/phpcompat",
            "tests/phpcompat/vendor/bin/phpcs --standard=phpcompat.xml.dist"
        ]
    },
    "scripts-descriptions": {
        "test": "PHPUnit default suite (needs the WordPress test library).",
        "test:ajax": "PHPUnit ajax group.",
        "lint:php": "Syntax-check shipped PHP, failing on compile-time deprecations.",
        "phpcs:changed": "WordPress Coding Standards on lines changed since BASE (default origin/master).",
        "phpcs:i18n": "Text domain sniff on every file.",
        "phpstan": "PHPStan level 1 against tests/phpstan/phpstan-baseline.neon.",
        "phpcompat": "PHPCompatibility 10 for PHP 7.4 to 8.6."
    },
    "require-dev": {
        "phpunit/phpunit": "^8.5",
        "yoast/phpunit-polyfills": "^3.0",
        "squizlabs/php_codesniffer": "^3.11",
        "wp-coding-standards/wpcs": "^3.1"
    }
}
